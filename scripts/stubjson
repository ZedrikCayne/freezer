JSCRIPT="root/freezer/api.js"

if [ -f ${JSCRIPT} ]; then rm ${JSCRIPT}; fi

SERVER_PREFIX="/freezer/"
URI_POSTFIX="_uri"

echo "const ServerApi = {" >  ${JSCRIPT}

PREFIX_CHAR=""
IFS=,
while read API_NAME TYPE METHOD CFUNC EXTRA; do
    API_PATH=$(echo $API_NAME | sed 's|_|/|g')
    THIS_URI="${SERVER_PREFIX}${API_PATH}"
    if [ $TYPE == "FILTER" ]; then
        THIS_URI="NULL"
    fi
    if [ $TYPE == "WILDCARD" ]; then
        THIS_URI="NULL"
    fi
    if [ $THIS_URI != "NULL" ]; then
        echo "${PREFIX_CHAR}" >> ${JSCRIPT}
        if [ $TYPE == "EXACT" ]; then
            echo "\"${API_NAME}\": async function ${API_NAME}(thing) {" >> ${JSCRIPT}
            echo "let retries = 2; while (retries > 0) { try {" >> ${JSCRIPT}
            echo "    if( thing === undefined ) {" >> ${JSCRIPT}
            echo "        var promise = fetch( \"${THIS_URI}\",{credentials:\"same-origin\",method:\"${METHOD}\"} ); retries = 0; return promise;" >> ${JSCRIPT}
            echo "    } else {" >> ${JSCRIPT}
            echo "        var promise = fetch( \"${THIS_URI}\",{credentials:\"same-origin\",method:\"${METHOD}\",body:thing} ); retries = 0; return promise; };" >> ${JSCRIPT}
            echo "    } catch(e) {retries--;} };" >> ${JSCRIPT}
            echo "}" >> ${JSCRIPT}
        else
            echo "\"${API_NAME}\": async function ${API_NAME}(what,thing) {" >> ${JSCRIPT}
            echo "let retries = 2; while (retries > 0) { try {" >> ${JSCRIPT}
            echo "    if( thing === undefined ) {" >> ${JSCRIPT}
            echo "        var promise = fetch( \"${THIS_URI}/\" + what,{credentials:\"same-origin\",method:\"${METHOD}\"} ); retries = 0; return promise;" >> ${JSCRIPT}
            echo "    } else {" >> ${JSCRIPT}
            echo "        var promise = fetch( \"${THIS_URI}/\" + what,{credentials:\"same-origin\",method:\"${METHOD}\",body:thing} ); retries = 0; return promise; }" >> ${JSCRIPT}
            echo "    } catch(e) {retries--;} };" >> ${JSCRIPT}
            echo "}" >> ${JSCRIPT}
        fi
        PREFIX_CHAR=","
    fi

done < api/freezerapidefn.csv

echo "};" >> ${JSCRIPT}
