CHEADER="src/freezerapi.h"
CDEFN="src/freezerapi.c"
CMAIN="src/freezer.c"
CMAINHEADER="src/freezer.h"
JSCRIPT="root/freezer/api.js"

if [ -f ${CHEADER} ]; then rm ${CHEADER}; fi
if [ -f ${CDEFN} ]; then rm ${CDEFN}; fi

SERVER_PREFIX="/freezer/"
URI_POSTFIX="_uri"

echo "#include <stdbool.h>"                  >  $CHEADER
echo "#include <crankshaft/server.h>"        >> $CHEADER
echo "#include <crankshaft/string.h>"        >> $CHEADER
echo "//Autogenerated touch at your peril"   >> $CHEADER
echo "#ifdef __cplusplus"                    >> $CHEADER
echo "extern \"C\" {"                        >> $CHEADER
echo "#endif"                                >> $CHEADER
echo "extern struct CS_Route freezerRoutes[];">> $CHEADER
echo "int32_t numFreezerRoutes(void);"       >> $CHEADER

echo "#include <stdbool.h>"                >  $CDEFN
echo "#include <crankshaft/server.h>"      >> $CDEFN
echo "#include <crankshaft/string.h>"      >> $CDEFN
echo "#include <crankshaft/util.h>"        >> $CDEFN
echo "#include \"freezer.h\""              >> $CDEFN
echo "//Autogenerated touch at your peril" >> $CDEFN


IFS=,
while read API_NAME TYPE METHOD CFUNC EXTRA; do
    API_PATH=$(echo $API_NAME | sed 's|_|/|g')
    #echo $API_NAME $TYPE $METHOD $CFUNC $EXTRA
    echo "extern const struct CS_String ${API_NAME}${URI_POSTFIX}; "     >> $CHEADER
    echo "const struct CS_String ${API_NAME}${URI_POSTFIX} = CS_STRING(\"${SERVER_PREFIX}${API_PATH}\");" >> $CDEFN
    if grep "${CFUNC}" "${CMAIN}" > /dev/null; then
        echo "Found ${CFUNC}" > /dev/null
    else
        if [[ ! "${CFUNC}" == "CS_*" ]]; then
            echo "bool ${CFUNC}( struct CS_ClientInfo *info ) {" >> $CMAIN
            echo "return true;" >> $CMAIN
            echo "}" >> $CMAIN
            echo "bool ${CFUNC}( struct CS_ClientInfo *info );" >> $CMAINHEADER
        fi
    fi
done < api/freezerapidefn.csv

echo "#ifdef __cplusplus"                  >> $CHEADER
echo "}"                                   >> $CHEADER
echo "#endif"                              >> $CHEADER

echo "struct CS_Route freezerRoutes[] = {" >> $CDEFN
while read API_NAME TYPE METHOD CFUNC EXTRA; do
    THIS_URI="&${API_NAME}${URI_POSTFIX}"
    if [ $TYPE == "FILTER" ]; then
        THIS_URI=NULL
    fi
    if [ $TYPE == "WILDCARD" ]; then
        THIS_URI=NULL
    fi
    if [ -z ${EXTRA} ]; then
        echo "{ CS_HTTP_METHOD_${METHOD}, CS_ROUTE_TYPE_${TYPE}, ${THIS_URI}, ${CFUNC}, NULL }," >> $CDEFN
    else 
        echo "{ CS_HTTP_METHOD_${METHOD}, CS_ROUTE_TYPE_${TYPE}, ${THIS_URI}, ${CFUNC}, \"${EXTRA}\" }," >> $CDEFN
    fi
done < api/freezerapidefn.csv
echo "};"  >> $CDEFN
echo "int32_t numFreezerRoutes(void){ return CS_ARRAY_SIZE(freezerRoutes); }" >> $CDEFN
